{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "bakuhantam-v2",
  "compatibility_date": "2025-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "account_id": "4ff140db4fae29f31ae5f481dc6fb6a4",
  "routes": [
    {
      "custom_domain": true,
      "pattern": "bakuhantam-v2.zakiego.com"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_API_URL": "https://bakuhantam-api.zakiego.com"
  }
}
